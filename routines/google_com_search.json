{
	"name": "google_com_search",
	"description": "",
	"params": {
		"search_term": {
			"description": "",
			"default": "",
			"kind": "str"
		},
		"max_pages": {
			"description": "",
			"default": "",
			"kind": "int"
		}
	},
	"url": "https://www.google.com",
	"render": true,
	"actions": [
		{
			"typ": "actionWaitForAndSelect",
			"v0": "//textarea[@name='q']",
			"v1": "1"
		},
		{
			"typ": "actionType",
			"v0": "||search_term||",
			"v1": ""
		},
		{
			"typ": "actionSleep",
			"v0": "1",
			"v1": ""
		},
		{
			"typ": "actionKeyboardEnter",
			"v0": "",
			"v1": ""
		},
		{
			"typ": "actionSleep",
			"v0": "2",
			"v1": ""
		}
	],
	"pagination": {
		"nextPageXPath": "//*[@id='pnnext']",
		"maxPages": "||max_pages||",
		"clickDelaySeconds": "2"
	},
	"extraction": "google_com_search_results",
	"version": "0.4",
	"type": "routine"
}
